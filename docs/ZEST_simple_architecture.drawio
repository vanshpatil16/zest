<mxfile host="app.diagrams.net" agent="Claude Code" pages="1">
  <diagram id="zest-simple" name="ZEST - Simple Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="ZEST - Emotion &amp; Speaker Voice Conversion (Simple View)" style="text;html=1;fontSize=20;fontStyle=1;align=center;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="900" height="36" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Transfer the EMOTION of a target clip onto SOURCE speech, keeping the source speaker's identity and words." style="text;html=1;fontSize=12;align=center;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="900" height="24" as="geometry" />
        </mxCell>
        <mxCell id="src" value="SOURCE SPEECH&#10;(what to say + whose voice)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="100" width="180" height="56" as="geometry" />
        </mxCell>
        <mxCell id="tgt" value="TARGET SPEECH&#10;(emotion reference)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="100" width="180" height="56" as="geometry" />
        </mxCell>
        <mxCell id="hubert" value="HuBERT&#10;(Content)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ecapa" value="ECAPA-TDNN&#10;(Speaker)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="210" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="yaapt" value="YAAPT&#10;(Pitch)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="210" width="160" height="50" as="geometry" />
