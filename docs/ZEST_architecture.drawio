        </mxCell>
        <mxCell id="i_tok" value="&lt;b&gt;HuBERT Tokens&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━&lt;br&gt;(T,) int ∈ [0,99]&lt;br&gt;pre-extracted" style="rounded=1;fillColor=#fff8e1;strokeColor=#f9a825;fontSize=10;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="28" y="225" width="174" height="75" as="geometry" />
        </mxCell>
        <mxCell id="i_spk" value="&lt;b&gt;EASE Embedding&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━&lt;br&gt;(256,) float&lt;br&gt;emotion-agnostic spk" style="rounded=1;fillColor=#e8f5e9;strokeColor=#388e3c;fontSize=10;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;whiteSpace=wrap;html=1;" vertex="1" parent="1">
