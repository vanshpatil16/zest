        </mxCell>
        <mxCell id="i_f0" value="&lt;b&gt;Target F0&lt;/b&gt; 🔴&lt;br&gt;━━━━━━━━━━━━━&lt;br&gt;(T,) Hz from YAAPT&lt;br&gt;training only" style="rounded=1;fillColor=#fff8e1;strokeColor=#e65100;fontSize=10;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 3;" vertex="1" parent="1">
