        <mxCell id="i_elbl" value="&lt;b&gt;Emotion Label&lt;/b&gt; 🔴&lt;br&gt;━━━━━━━━━━━━━&lt;br&gt;int ∈ [0,4]&lt;br&gt;angry/happy/sad/surp/neut" style="rounded=1;fillColor=#fff8e1;strokeColor=#e65100;fontSize=10;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 3;" vertex="1" parent="1">
          <mxGeometry x="28" y="680" width="174" height="75" as="geometry" />
        </mxCell>
        <mxCell id="i_slbl" value="&lt;b&gt;Speaker Label&lt;/b&gt; 🔴&lt;br&gt;━━━━━━━━━━━━━&lt;br&gt;int ∈ [0,9]&lt;br&gt;10 speakers (ESD)" style="rounded=1;fillColor=#fff8e1;strokeColor=#e65100;fontSize=10;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 3;" vertex="1" parent="1">
          <mxGeometry x="28" y="790" width="174" height="75" as="geometry" />
        </mxCell>
        <!-- ── WAV2VEC / SACE column ── -->
        <mxCell id="w2vin" value="&lt;b&gt;Wav2Vec2 Forward&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;Model: wav2vec2-large-robust-ft-swbd&lt;br&gt;output_hidden_states = True&lt;br&gt;Sum all 13 hidden layers element-wise&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; (T, 768) → permute → (768, T)" style="rounded=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=10;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="228" y="80" width="274" height="110" as="geometry" />
        </mxCell>
        <mxCell id="w2vemo" value="&lt;b&gt;Emotion Branch (CNN)&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;conv1: Conv1d(768→128, k=5, pad=2)&lt;br&gt;conv2: Conv1d(128→128, k=5, pad=2)&lt;br&gt;Permute → (T, 128) frame features&lt;br&gt;Mean pool → (128,) utterance vec&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; FC(128→5) → emo logits (5,)" style="rounded=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=10;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="228" y="220" width="274" height="140" as="geometry" />
        </mxCell>
        <mxCell id="w2vadv" value="&lt;b&gt;Speaker Adversarial Branch&lt;/b&gt; ↺&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;feat → &lt;b&gt;ReverseLayerF(feat, α)&lt;/b&gt;&lt;br&gt;conv3: Conv1d(768→128, k=5)&lt;br&gt;conv4: Conv1d(128→128, k=5)&lt;br&gt;Mean pool → (128,)&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; FC(128→10) → spkr logits (10,)" style="rounded=1;fillColor=#fce4ec;strokeColor=#c62828;fontSize=10;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 3;" vertex="1" parent="1">
          <mxGeometry x="228" y="400" width="274" height="150" as="geometry" />
        </mxCell>
        <!-- ── PitchModel column ── -->
        <mxCell id="pm_emb" value="&lt;b&gt;Token Embedding&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;nn.Embedding(101, 128, padding_idx=100)&lt;br&gt;&lt;b&gt;In:&lt;/b&gt;&amp;nbsp; tokens (B, T) int&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; hidden (B, T, 128)" style="rounded=1;fillColor=#e0f7fa;strokeColor=#00796b;fontSize=10;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="528" y="80" width="344" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pm_spk" value="&lt;b&gt;Speaker Context Addition&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;EASE (B,256) → speaker_linear Linear(256→128)&lt;br&gt;Expand: (B,1,128) → repeat → (B,T,128)&lt;br&gt;emo_embedded += speaker_proj&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; fused context (B, T, 128)" style="rounded=1;fillColor=#e0f7fa;strokeColor=#00796b;fontSize=10;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="528" y="210" width="344" height="115" as="geometry" />
        </mxCell>
        <mxCell id="pm_attn" value="&lt;b&gt;CrossAttentionModel (4-head, 256-dim)&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;&lt;b&gt;Q&lt;/b&gt; = hidden &amp;nbsp;&amp;nbsp;&amp;nbsp;→ fc_q Linear(128→256)&lt;br&gt;&lt;b&gt;K&lt;/b&gt; = context → fc_k Linear(128→256)&lt;br&gt;&lt;b&gt;V&lt;/b&gt; = context → fc_v Linear(128→256)&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;Scores = Q·Kᵀ / √64 → softmax → ·V&lt;br&gt;→ cross (B,T,256), dropout=0.5&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;skip = fc(cross) Linear(256→128)&lt;br&gt;skip += hidden &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#39;#666&#39;&gt;[residual ①]&lt;/font&gt;&lt;br&gt;skip = LayerNorm(relu(skip))&lt;br&gt;new = fc_1(skip) Linear(128→128)&lt;br&gt;new += skip &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&#39;#666&#39;&gt;[residual ②]&lt;/font&gt;&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; LayerNorm(relu(new)) → (B,T,128)" style="rounded=1;fillColor=#b2ebf2;strokeColor=#00796b;fontSize=10;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="528" y="365" width="344" height="310" as="geometry" />
        </mxCell>
        <mxCell id="pm_cnn" value="&lt;b&gt;CNN Head + De-log&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;Permute (B,T,128) → (B,128,T)&lt;br&gt;Conv1d(128→128, k=3, pad=1) + LeakyReLU&lt;br&gt;Conv1d(128→1, k=1) → squeeze → (B,T)&lt;br&gt;Mask padding frames to 0.0&lt;br&gt;&lt;b&gt;pred_f0 = exp(logit) − 1&lt;/b&gt;&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; F0 Hz (B, T) · 60–300 Hz" style="rounded=1;fillColor=#a5f3f7;strokeColor=#00796b;fontSize=10;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="528" y="715" width="344" height="145" as="geometry" />
        </mxCell>
        <!-- ── LOSS column ── -->
        <mxCell id="l1" value="&lt;b&gt;loss1 · F0 Regression (L1)&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;loss1 = (mask · |pred_f0 − f0_target|).sum()&lt;br&gt;&lt;br&gt;&lt;b&gt;mask&lt;/b&gt; ∈ {0,1}: 1 = voiced frame&lt;br&gt;&lt;b&gt;Why L1:&lt;/b&gt; robust to YAAPT errors&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;F0 not Gaussian → L1 better" style="rounded=1;fillColor=#fff8e1;strokeColor=#f9a825;fontSize=10;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="898" y="80" width="324" height="140" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="&lt;b&gt;loss2 · Emotion Adversarial (CE)&lt;/b&gt; ↺&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;loss2 = CrossEntropy(emo_logits, emo_label)&lt;br&gt;&lt;br&gt;&lt;b&gt;Forward:&lt;/b&gt; predict emotion class&lt;br&gt;&lt;b&gt;Backward:&lt;/b&gt; gradient REVERSED&lt;br&gt;→ F0 features become&lt;br&gt;&amp;nbsp;&amp;nbsp; emotion-&lt;b&gt;invariant&lt;/b&gt;&lt;br&gt;&lt;b&gt;Weight: 1000×&lt;/b&gt; (scales to L1)" style="rounded=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=10;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="898" y="260" width="324" height="175" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="&lt;b&gt;loss3 · Speaker Adversarial (CE)&lt;/b&gt; ↺&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;loss3 = CrossEntropy(spk_logits, spk_label)&lt;br&gt;&lt;br&gt;&lt;b&gt;Forward:&lt;/b&gt; predict speaker ID&lt;br&gt;&lt;b&gt;Backward:&lt;/b&gt; gradient REVERSED&lt;br&gt;→ F0 features become&lt;br&gt;&amp;nbsp;&amp;nbsp; speaker-&lt;b&gt;invariant&lt;/b&gt;&lt;br&gt;&lt;b&gt;Weight: 1000×&lt;/b&gt; (zero-shot key)" style="rounded=1;fillColor=#e8f5e9;strokeColor=#388e3c;fontSize=10;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="898" y="478" width="324" height="175" as="geometry" />
        </mxCell>
        <mxCell id="ltot" value="&lt;b&gt;Total Loss + Optimizer&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;&lt;b&gt;total = loss1 + 1000·loss2 + 1000·loss3&lt;/b&gt;&lt;br&gt;&lt;br&gt;Adam lr = 1e-3&lt;br&gt;Decay: × 0.5 every 7 epochs&lt;br&gt;Epochs: 500 &amp;nbsp;|&amp;nbsp; Batch: 24&lt;br&gt;Val: loss1 + 1000·loss2 only" style="rounded=1;fillColor=#fff8e1;strokeColor=#e65100;fontSize=10;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;whiteSpace=wrap;html=1;dashed=1;dashPattern=7 4;" vertex="1" parent="1">
          <mxGeometry x="898" y="696" width="324" height="150" as="geometry" />
        </mxCell>
        <!-- ── GRAD REVERSAL column ── -->
        <mxCell id="rev_code" value="&lt;b&gt;class ReverseLayerF(torch.autograd.Function)&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;&lt;b&gt;FORWARD&lt;/b&gt; — identity pass&lt;br&gt;&amp;nbsp;&amp;nbsp;def forward(ctx, x, alpha):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ctx.alpha = alpha&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return x.view_as(x)&lt;br&gt;&lt;br&gt;&lt;b&gt;BACKWARD&lt;/b&gt; — negate gradient&lt;br&gt;&amp;nbsp;&amp;nbsp;def backward(ctx, grad_output):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return grad_output.neg() * ctx.alpha, None" style="rounded=1;fillColor=#fce4ec;strokeColor=#c62828;fontSize=10;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1248" y="80" width="524" height="200" as="geometry" />
        </mxCell>
        <mxCell id="rev_sched" value="&lt;b&gt;α Schedule (sigmoid ramp)&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;p = (batch + epoch × steps_per_epoch) / (100 × steps)&lt;br&gt;&lt;br&gt;&lt;b&gt;α(p) = 2 / (1 + exp(−10 · p)) − 1&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;p = 0.0 → α ≈ −1.0 &amp;nbsp; early: normal training&lt;br&gt;&amp;nbsp;&amp;nbsp;p = 0.5 → α = &amp;nbsp;0.0 &amp;nbsp; mid: no reversal&lt;br&gt;&amp;nbsp;&amp;nbsp;p = 1.0 → α ≈ +1.0 &amp;nbsp; late: full adversarial&lt;br&gt;&lt;br&gt;&lt;font color=&#39;#555&#39;&gt;Sigmoid ramp prevents collapse at start&lt;/font&gt;" style="rounded=1;fillColor=#fce4ec;strokeColor=#c62828;fontSize=10;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1248" y="315" width="524" height="200" as="geometry" />
        </mxCell>
        <mxCell id="rev_effect" value="&lt;b&gt;Why Adversarial Works&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;&lt;b&gt;Without reversal:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;↓ CE loss → features encode emotion&lt;br&gt;&lt;br&gt;&lt;b&gt;With reversal (α &gt; 0):&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;dL/dfeats = −α · dCE/dfeats&lt;br&gt;&amp;nbsp;&amp;nbsp;→ gradient pushes features to CONFUSE classifier&lt;br&gt;&amp;nbsp;&amp;nbsp;→ features become emotion-&lt;b&gt;INVARIANT&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Equilibrium:&lt;/b&gt; classifier at chance level (20%)&lt;br&gt;&amp;nbsp;&amp;nbsp;→ F0 cannot leak source emotion&lt;br&gt;&amp;nbsp;&amp;nbsp;→ only SACE reference signal controls emotion" style="rounded=1;fillColor=#e8f5e9;strokeColor=#388e3c;fontSize=10;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1248" y="548" width="524" height="210" as="geometry" />
        </mxCell>
        <!-- ── Edges Page 2 ── -->
        <mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#7b1fa2;strokeWidth=2;fontSize=9;" value="wav" edge="1" parent="1" source="i_wav" target="w2vin">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#00796b;strokeWidth=2;fontSize=9;" value="tokens (T,)" edge="1" parent="1" source="i_tok" target="pm_emb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#388e3c;strokeWidth=2;fontSize=9;" value="EASE (256,)" edge="1" parent="1" source="i_spk" target="pm_spk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#7b1fa2;strokeWidth=1;fontSize=9;" value="(768,T)" edge="1" parent="1" source="w2vin" target="w2vemo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#7b1fa2;strokeWidth=1;fontSize=9;labelBackgroundColor=#fff;" value="(T,128) emo feats" edge="1" parent="1" source="w2vemo" target="pm_spk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#00796b;strokeWidth=1;fontSize=9;labelBackgroundColor=#fff;" value="units (B,T,128)" edge="1" parent="1" source="pm_emb" target="pm_attn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#00796b;strokeWidth=1;fontSize=9;labelBackgroundColor=#fff;" value="ctx (B,T,128)" edge="1" parent="1" source="pm_spk" target="pm_attn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#00796b;strokeWidth=1;fontSize=9;labelBackgroundColor=#fff;" value="(B,T,128)" edge="1" parent="1" source="pm_attn" target="pm_cnn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#f9a825;strokeWidth=1;fontSize=9;dashed=1;labelBackgroundColor=#fff;" value="pred F0" edge="1" parent="1" source="pm_cnn" target="l1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#e65100;strokeWidth=1;fontSize=9;dashed=1;dashPattern=6 3;labelBackgroundColor=#fff;" value="target F0" edge="1" parent="1" source="i_f0" target="l1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#7b1fa2;strokeWidth=1;fontSize=9;dashed=1;labelBackgroundColor=#fff;" value="emo logits (5,)" edge="1" parent="1" source="w2vemo" target="l2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#c62828;strokeWidth=1;fontSize=9;dashed=1;dashPattern=6 3;labelBackgroundColor=#fff;" value="spkr logits (10,)" edge="1" parent="1" source="w2vadv" target="l3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p3" name="③ HiFi-GAN Detail">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" pageWidth="1800" pageHeight="940" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ttl3" value="&lt;b&gt;HiFi-GAN CodeGenerator + Discriminators&lt;/b&gt;&lt;br&gt;models.py · hubert_alladv.json" style="text;html=1;fontSize=15;fontStyle=1;align=center;fontColor=#b71c1c;" vertex="1" parent="1">
          <mxGeometry x="20" y="8" width="1760" height="36" as="geometry" />
        </mxCell>
        <!-- ── BAND BACKGROUNDS ── -->
        <mxCell id="bg_gen" value="&lt;b&gt;CodeGenerator.forward()&lt;/b&gt;" style="rounded=0;fillColor=#fce4ec;strokeColor=#c62828;verticalAlign=top;fontSize=11;fontStyle=1;html=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="50" width="520" height="880" as="geometry" />
        </mxCell>
        <mxCell id="bg_res" value="&lt;b&gt;ResBlock1 (MRF)&lt;/b&gt;" style="rounded=0;fillColor=#fff8e1;strokeColor=#f9a825;verticalAlign=top;fontSize=11;fontStyle=1;html=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="50" width="400" height="430" as="geometry" />
        </mxCell>
        <mxCell id="bg_mpd" value="&lt;b&gt;MultiPeriodDiscriminator&lt;/b&gt;" style="rounded=0;fillColor=#e8f5e9;strokeColor=#388e3c;verticalAlign=top;fontSize=11;fontStyle=1;html=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="490" width="400" height="440" as="geometry" />
        </mxCell>
        <mxCell id="bg_msd" value="&lt;b&gt;MultiScaleDiscriminator&lt;/b&gt;" style="rounded=0;fillColor=#e3f2fd;strokeColor=#1565c0;verticalAlign=top;fontSize=11;fontStyle=1;html=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="50" width="440" height="440" as="geometry" />
        </mxCell>
        <mxCell id="bg_loss" value="&lt;b&gt;GAN Losses&lt;/b&gt;" style="rounded=0;fillColor=#fff3e0;strokeColor=#e65100;verticalAlign=top;fontSize=11;fontStyle=1;html=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="500" width="440" height="430" as="geometry" />
        </mxCell>
        <mxCell id="bg_cfg" value="&lt;b&gt;Config (hubert_alladv.json)&lt;/b&gt;" style="rounded=0;fillColor=#f3e5f5;strokeColor=#7b1fa2;verticalAlign=top;fontSize=11;fontStyle=1;html=1;" vertex="1" parent="1">
          <mxGeometry x="1410" y="50" width="370" height="880" as="geometry" />
        </mxCell>
        <!-- ── GENERATOR steps ── -->
        <mxCell id="g_cond" value="&lt;b&gt;Inputs&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;code (B,T) int &amp;nbsp;&amp;nbsp;← HuBERT units&lt;br&gt;f0 &amp;nbsp;&amp;nbsp;(B,1,T) &amp;nbsp;&amp;nbsp;← predicted F0&lt;br&gt;spkr (B,256) &amp;nbsp;&amp;nbsp;← EASE embedding&lt;br&gt;emo &amp;nbsp;(B,128) &amp;nbsp;&amp;nbsp;← SACE embedding" style="rounded=1;fillColor=#fce4ec;strokeColor=#c62828;fontSize=10;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="28" y="80" width="504" height="110" as="geometry" />
        </mxCell>
        <mxCell id="g_emb" value="&lt;b&gt;① Unit Embedding&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;self.dict = nn.Embedding(100, 128)&lt;br&gt;code (B,T) → embed (B,T,128) → transpose&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; (B, 128, T)" style="rounded=1;fillColor=#fce4ec;strokeColor=#c62828;fontSize=10;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="28" y="210" width="504" height="85" as="geometry" />
        </mxCell>
        <mxCell id="g_stack" value="&lt;b&gt;② Conditioning Stack&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;units_emb: (B,128,T)&lt;br&gt;f0_enc: &amp;nbsp;&amp;nbsp;(B,128,T) &amp;nbsp;&amp;nbsp;F0Encoder Conv1d stack&lt;br&gt;spkr: &amp;nbsp;&amp;nbsp;&amp;nbsp;(B,256,T) &amp;nbsp;&amp;nbsp;broadcast scalar&lt;br&gt;sace: &amp;nbsp;&amp;nbsp;&amp;nbsp;(B,128,T) &amp;nbsp;&amp;nbsp;broadcast scalar&lt;br&gt;&lt;b&gt;cat(dim=1) → (B, 640, T)&lt;/b&gt;&lt;br&gt;conv_pre Conv1d(640→512, k=7) → (B,512,T)" style="rounded=1;fillColor=#f8bbd0;strokeColor=#c62828;fontSize=10;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="28" y="315" width="504" height="150" as="geometry" />
        </mxCell>
        <mxCell id="g_ups" value="&lt;b&gt;③ Upsample Stages — ×160 total&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;&amp;nbsp;&amp;nbsp;ConvTranspose1d(512→256, k=11, ×5) + MRF&lt;br&gt;&amp;nbsp;&amp;nbsp;ConvTranspose1d(256→128, k=8,  ×4) + MRF&lt;br&gt;&amp;nbsp;&amp;nbsp;ConvTranspose1d(128→64,  k=8,  ×4) + MRF&lt;br&gt;&amp;nbsp;&amp;nbsp;ConvTranspose1d(64→32,   k=4,  ×2) + MRF&lt;br&gt;Channels: 512 → 256 → 128 → 64 → 32&lt;br&gt;MRF = 3 parallel ResBlock1 [k=3,7,11] averaged" style="rounded=1;fillColor=#f8bbd0;strokeColor=#c62828;fontSize=10;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="28" y="485" width="504" height="160" as="geometry" />
        </mxCell>
        <mxCell id="g_out" value="&lt;b&gt;④ Output&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;LeakyReLU(0.1)&lt;br&gt;conv_post Conv1d(32→1, k=7, pad=3)&lt;br&gt;tanh → waveform ∈ [−1, +1]&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; (B, 1, T×160) · 16 kHz PCM" style="rounded=1;fillColor=#f8bbd0;strokeColor=#c62828;fontSize=10;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="28" y="665" width="504" height="105" as="geometry" />
        </mxCell>
        <mxCell id="g_trn" value="&lt;b&gt;⑤ Training Config&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;AdamW lr=2e-4 · β=[0.8, 0.99]&lt;br&gt;LR decay × 0.999 per step&lt;br&gt;100 000 steps · batch_size=32&lt;br&gt;segment_size=8960 samples (0.56 s)" style="rounded=1;fillColor=#fff8e1;strokeColor=#e65100;fontSize=10;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;whiteSpace=wrap;html=1;dashed=1;dashPattern=7 4;" vertex="1" parent="1">
          <mxGeometry x="28" y="790" width="504" height="110" as="geometry" />
        </mxCell>
        <!-- ── RESBLOCK ── -->
        <mxCell id="res_title" value="&lt;b&gt;ResBlock1 per kernel (e.g. k=7)&lt;/b&gt;&lt;br&gt;Input (B, C, T)" style="rounded=1;fillColor=#fff8e1;strokeColor=#f9a825;fontSize=10;align=center;html=1;" vertex="1" parent="1">
          <mxGeometry x="558" y="80" width="384" height="44" as="geometry" />
        </mxCell>
        <mxCell id="res_d1" value="LeakyReLU(0.1) → Conv1d(C, C, k, dil=1) + wNorm" style="rounded=1;fillColor=#fff8e1;strokeColor=#f9a825;fontSize=10;align=center;html=1;" vertex="1" parent="1">
          <mxGeometry x="558" y="144" width="384" height="36" as="geometry" />
        </mxCell>
        <mxCell id="res_d1b" value="LeakyReLU(0.1) → Conv1d(C, C, k, dil=1) + wNorm" style="rounded=1;fillColor=#fff8e1;strokeColor=#f9a825;fontSize=10;align=center;html=1;" vertex="1" parent="1">
          <mxGeometry x="558" y="190" width="384" height="36" as="geometry" />
        </mxCell>
        <mxCell id="res_add" value="x += residual" style="ellipse;fillColor=#ffe082;strokeColor=#f9a825;fontSize=10;align=center;html=1;" vertex="1" parent="1">
          <mxGeometry x="678" y="234" width="144" height="30" as="geometry" />
        </mxCell>
        <mxCell id="res_d3" value="LeakyReLU(0.1) → Conv1d(C, C, k, dil=3) + wNorm" style="rounded=1;fillColor=#fff8e1;strokeColor=#f9a825;fontSize=10;align=center;html=1;" vertex="1" parent="1">
          <mxGeometry x="558" y="276" width="384" height="36" as="geometry" />
        </mxCell>
        <mxCell id="res_d3b" value="LeakyReLU(0.1) → Conv1d(C, C, k, dil=1) + wNorm" style="rounded=1;fillColor=#fff8e1;strokeColor=#f9a825;fontSize=10;align=center;html=1;" vertex="1" parent="1">
          <mxGeometry x="558" y="322" width="384" height="36" as="geometry" />
        </mxCell>
        <mxCell id="res_note" value="&lt;font color=&#39;#666&#39;&gt;3rd pair: dil=5 (same pattern)&lt;br&gt;MRF averages 3 ResBlocks [k=3,7,11]&lt;br&gt;→ multi-scale temporal receptive field&lt;/font&gt;" style="rounded=1;fillColor=#fffde7;strokeColor=#f9a825;fontSize=9.5;align=center;html=1;" vertex="1" parent="1">
          <mxGeometry x="558" y="370" width="384" height="64" as="geometry" />
        </mxCell>
        <!-- ── MPD ── -->
        <mxCell id="mpd_in" value="&lt;b&gt;Input:&lt;/b&gt; waveform (B, 1, T) — 5 instances: periods [2, 3, 5, 7, 11]" style="rounded=1;fillColor=#e8f5e9;strokeColor=#388e3c;fontSize=10;align=center;html=1;" vertex="1" parent="1">
          <mxGeometry x="558" y="510" width="384" height="36" as="geometry" />
        </mxCell>
        <mxCell id="mpd_reshape" value="&lt;b&gt;Reshape for period p:&lt;/b&gt;&lt;br&gt;pad T → multiple of p&lt;br&gt;view(B, 1, T//p, p) &amp;nbsp; [2D time-period grid]&lt;br&gt;Captures: periodicity at pitch timescales" style="rounded=1;fillColor=#e8f5e9;strokeColor=#388e3c;fontSize=10;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="558" y="558" width="384" height="80" as="geometry" />
        </mxCell>
        <mxCell id="mpd_conv" value="&lt;b&gt;5-layer Conv2d stack (weight_norm):&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;Conv2d(1→32, &amp;nbsp;&amp;nbsp;k=(5,1), stride=(3,1))&lt;br&gt;&amp;nbsp;&amp;nbsp;Conv2d(32→128, k=(5,1), stride=(3,1))&lt;br&gt;&amp;nbsp;&amp;nbsp;Conv2d(128→512,k=(5,1), stride=(3,1))&lt;br&gt;&amp;nbsp;&amp;nbsp;Conv2d(512→1024,k=(5,1),stride=(3,1))&lt;br&gt;&amp;nbsp;&amp;nbsp;Conv2d(1024→1024,k=(5,1),stride=1)&lt;br&gt;Each + LeakyReLU(0.1) → append to fmap&lt;br&gt;conv_post Conv2d(1024→1, k=(3,1)) → logit" style="rounded=1;fillColor=#e8f5e9;strokeColor=#388e3c;fontSize=10;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="558" y="650" width="384" height="185" as="geometry" />
        </mxCell>
        <!-- ── MSD ── -->
        <mxCell id="msd_in" value="&lt;b&gt;Input: waveform at 3 scales&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;Scale 0: 1×   &amp;nbsp;&amp;nbsp;spectral_norm &amp;nbsp;&amp;nbsp;full freq detail&lt;br&gt;&amp;nbsp;&amp;nbsp;Scale 1: ≈4×   AvgPool(4,2) &amp;nbsp;&amp;nbsp;pitch/formants&lt;br&gt;&amp;nbsp;&amp;nbsp;Scale 2: ≈16× AvgPool(4,2) &amp;nbsp;&amp;nbsp;prosody" style="rounded=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=10;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="968" y="80" width="424" height="100" as="geometry" />
        </mxCell>
        <mxCell id="msd_conv" value="&lt;b&gt;DiscriminatorS — 7 Conv1d layers:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;L0: Conv1d(1→128, k=15, s=1, p=7)&lt;br&gt;&amp;nbsp;&amp;nbsp;L1: Conv1d(128→128, k=41, s=2, g=4)&lt;br&gt;&amp;nbsp;&amp;nbsp;L2: Conv1d(128→256, k=41, s=2, g=16)&lt;br&gt;&amp;nbsp;&amp;nbsp;L3: Conv1d(256→512, k=41, s=4, g=16)&lt;br&gt;&amp;nbsp;&amp;nbsp;L4: Conv1d(512→1024,k=41, s=4, g=16)&lt;br&gt;&amp;nbsp;&amp;nbsp;L5: Conv1d(1024→1024,k=41,s=1, g=16)&lt;br&gt;&amp;nbsp;&amp;nbsp;L6: Conv1d(1024→1024,k=5, s=1)&lt;br&gt;conv_post Conv1d(1024→1, k=3) → logit&lt;br&gt;Each + LeakyReLU(0.1) → append to fmap" style="rounded=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=10;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="968" y="192" width="424" height="240" as="geometry" />
        </mxCell>
        <mxCell id="msd_note" value="&lt;font color=&#39;#555&#39;&gt;g = groups (depthwise-separable) → fewer params.&lt;br&gt;Scale 0 uses spectral_norm; scales 1,2 use weight_norm.&lt;/font&gt;" style="rounded=1;fillColor=#e8eaf6;strokeColor=#1565c0;fontSize=9.5;align=center;html=1;" vertex="1" parent="1">
          <mxGeometry x="968" y="444" width="424" height="36" as="geometry" />
        </mxCell>
        <!-- ── LOSSES ── -->
        <mxCell id="l_disc" value="&lt;b&gt;discriminator_loss (Hinge)&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;for dr, dg in zip(real_logits, gen_logits):&lt;br&gt;&amp;nbsp;&amp;nbsp;loss += mean(clamp(1 − dr, min=0))&lt;br&gt;&amp;nbsp;&amp;nbsp;loss += mean(clamp(1 + dg, min=0))&lt;br&gt;&lt;br&gt;Real: dr &gt; 1 → 0 ✓ &amp;nbsp;&amp;nbsp;else 1−dr (penalty)&lt;br&gt;Fake: dg &lt; −1 → 0 ✓ else 1+dg (penalty)&lt;br&gt;8 discriminators total (5 MPD + 3 MSD)" style="rounded=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=10;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="968" y="510" width="424" height="190" as="geometry" />
        </mxCell>
        <mxCell id="l_gen" value="&lt;b&gt;generator_loss (total)&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;L_gan  = Σ mean(clamp(1−dg, min=0))&lt;br&gt;L_feat = Σ Σ L1(fmap_real, fmap_gen)&lt;br&gt;L_mel  = L1(mel(gen), mel(real))&lt;br&gt;&lt;br&gt;&lt;b&gt;Total = L_gan + 10·L_feat + 45·L_mel&lt;/b&gt;&lt;br&gt;&lt;br&gt;L_feat 10× → perceptual quality&lt;br&gt;L_mel &amp;nbsp;45× → spectral fidelity" style="rounded=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=10;align=left;verticalAlign=top;spacingLeft=7;spacingTop=5;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="968" y="712" width="424" height="200" as="geometry" />
        </mxCell>
        <!-- ── CONFIG column ── -->
        <mxCell id="cfg" value="&lt;b&gt;hubert_alladv.json&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;&lt;br&gt;&lt;b&gt;Upsampling:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;upsample_rates: [5, 4, 4, 2, 2]&lt;br&gt;&amp;nbsp;&amp;nbsp;upsample_kernel_sizes: [11,8,8,4,4]&lt;br&gt;&amp;nbsp;&amp;nbsp;upsample_initial_channel: 512&lt;br&gt;&lt;br&gt;&lt;b&gt;MRF Blocks:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;resblock_kernel_sizes: [3, 7, 11]&lt;br&gt;&amp;nbsp;&amp;nbsp;resblock_dilation_sizes:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;[[1,3,5], [1,3,5], [1,3,5]]&lt;br&gt;&lt;br&gt;&lt;b&gt;Units:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;num_embeddings: 100&lt;br&gt;&amp;nbsp;&amp;nbsp;embedding_dim: 128&lt;br&gt;&amp;nbsp;&amp;nbsp;model_in_dim: 512&lt;br&gt;&lt;br&gt;&lt;b&gt;F0:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;f0: true&lt;br&gt;&amp;nbsp;&amp;nbsp;f0_normalize: true&lt;br&gt;&lt;br&gt;&lt;b&gt;Speaker:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;multispkr: &quot;_&quot; (enabled)&lt;br&gt;&lt;br&gt;&lt;b&gt;Audio:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;sampling_rate: 16000&lt;br&gt;&amp;nbsp;&amp;nbsp;segment_size: 8960&lt;br&gt;&amp;nbsp;&amp;nbsp;code_hop_size: 320&lt;br&gt;&lt;br&gt;&lt;b&gt;Optimizer:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;learning_rate: 0.0002&lt;br&gt;&amp;nbsp;&amp;nbsp;adam_b1: 0.8&lt;br&gt;&amp;nbsp;&amp;nbsp;adam_b2: 0.99&lt;br&gt;&amp;nbsp;&amp;nbsp;lr_decay: 0.999" style="rounded=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;spacingRight=6;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1418" y="80" width="354" height="670" as="geometry" />
        </mxCell>
        <!-- ── Edges Page 3 ── -->
        <mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#c62828;strokeWidth=1;" edge="1" parent="1" source="g_cond" target="g_emb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#c62828;strokeWidth=1;" edge="1" parent="1" source="g_emb" target="g_stack">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#c62828;strokeWidth=1;fontSize=9;labelBackgroundColor=#fff;" value="(B,512,T)" edge="1" parent="1" source="g_stack" target="g_ups">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#c62828;strokeWidth=2;fontSize=9;labelBackgroundColor=#fff;" value="(B,32,T×160)" edge="1" parent="1" source="g_ups" target="g_out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#e65100;strokeWidth=1;fontSize=9;dashed=1;dashPattern=6 3;labelBackgroundColor=#fff;" value="fake wav" edge="1" parent="1" source="g_out" target="mpd_in">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#e65100;strokeWidth=1;fontSize=9;dashed=1;dashPattern=6 3;labelBackgroundColor=#fff;" value="fake wav" edge="1" parent="1" source="g_out" target="msd_in">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#388e3c;strokeWidth=1;fontSize=9;dashed=1;labelBackgroundColor=#fff;" value="logits+fmaps" edge="1" parent="1" source="mpd_conv" target="l_disc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#1565c0;strokeWidth=1;fontSize=9;dashed=1;labelBackgroundColor=#fff;" value="logits+fmaps" edge="1" parent="1" source="msd_conv" target="l_disc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#e65100;strokeWidth=1;fontSize=9;dashed=1;labelBackgroundColor=#fff;" value="→ gen update" edge="1" parent="1" source="l_disc" target="l_gen">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
