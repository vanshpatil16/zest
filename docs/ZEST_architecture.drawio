        <mxCell id="src" parent="1" style="rounded=1;arcSize=10;fillColor=#dce8fb;strokeColor=#5c7cbe;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;whiteSpace=wrap;html=1;" value="&lt;b&gt;Source Speech&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━&lt;br&gt;WAV · 16 kHz · mono&lt;br&gt;&lt;br&gt;&lt;font color=&#39;#1565c0&#39;&gt;&lt;b&gt;Provides:&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• Linguistic content&lt;br&gt;• Speaker identity&lt;br&gt;• F0 baseline" vertex="1">
          <mxGeometry height="140" width="190" x="30" y="130" as="geometry" />
        </mxCell>
        <mxCell id="ref" parent="1" style="rounded=1;arcSize=10;fillColor=#dce8fb;strokeColor=#5c7cbe;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;whiteSpace=wrap;html=1;" value="&lt;b&gt;Reference Speech&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━&lt;br&gt;WAV · 16 kHz · mono&lt;br&gt;&lt;br&gt;&lt;font color=&#39;#6a1b9a&#39;&gt;&lt;b&gt;Provides:&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• Target emotion&lt;br&gt;• Prosody pattern&lt;br&gt;&lt;i&gt;Any speaker · any text&lt;/i&gt;" vertex="1">
          <mxGeometry height="140" width="190" x="30" y="420" as="geometry" />
        </mxCell>
        <mxCell id="data" parent="1" style="rounded=1;arcSize=10;fillColor=#fff8e1;strokeColor=#e65100;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;whiteSpace=wrap;html=1;dashed=1;dashPattern=7 4;" value="&lt;b&gt;Training Labels&lt;/b&gt; 🔴&lt;br&gt;━━━━━━━━━━━━━━━━━━&lt;br&gt;&lt;b&gt;ESD:&lt;/b&gt; 10 spk × 5 emo&lt;br&gt;&lt;b&gt;CREMA-D:&lt;/b&gt; crowd-sourced&lt;br&gt;&lt;br&gt;Classes: angry · happy&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;sad · surprised · neutral" vertex="1">
          <mxGeometry height="120" width="190" x="30" y="690" as="geometry" />
        </mxCell>
        <mxCell id="hubert" parent="1" style="rounded=1;arcSize=8;fillColor=#fff8e1;strokeColor=#f9a825;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;whiteSpace=wrap;html=1;" value="&lt;b&gt;HuBERT Layer 9&lt;/b&gt; 🔒&lt;br&gt;&lt;font color=&#39;#888&#39;&gt;hubert-large-ll60k&lt;/font&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━&lt;br&gt;&lt;b&gt;In:&lt;/b&gt;&amp;nbsp; WAV → hidden (T, 768)&lt;br&gt;&lt;b&gt;Op:&lt;/b&gt;&amp;nbsp; K-means · K = 100&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; (T,) int ∈ [0, 99]&lt;br&gt;&lt;br&gt;50 Hz · 320 samp/frame&lt;br&gt;Encodes &lt;i&gt;phoneme content&lt;/i&gt;" vertex="1">
          <mxGeometry height="160" width="246" x="252" y="120" as="geometry" />
        </mxCell>
        <mxCell id="yaapt" parent="1" style="rounded=1;arcSize=8;fillColor=#fff8e1;strokeColor=#e65100;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;whiteSpace=wrap;html=1;dashed=1;dashPattern=7 4;" value="&lt;b&gt;YAAPT F0 Tracker&lt;/b&gt; 🔒 🔴&lt;br&gt;&lt;font color=&#39;#888&#39;&gt;autocorrelation algorithm&lt;/font&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━&lt;br&gt;&lt;b&gt;In:&lt;/b&gt;&amp;nbsp; source WAV&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; F0 contour (T,) Hz&lt;br&gt;&lt;br&gt;60–300 Hz voiced, 0 unvoiced&lt;br&gt;&lt;i&gt;Training target only — not&lt;/i&gt;&lt;br&gt;&lt;i&gt;used at inference&lt;/i&gt;" vertex="1">
          <mxGeometry height="150" width="246" x="252" y="310" as="geometry" />
        </mxCell>
        <mxCell id="xvec" parent="1" style="rounded=1;arcSize=8;fillColor=#fff8e1;strokeColor=#f9a825;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;whiteSpace=wrap;html=1;" value="&lt;b&gt;ECAPA-TDNN&lt;/b&gt; 🔒&lt;br&gt;&lt;font color=&#39;#888&#39;&gt;SpeechBrain · VoxCeleb2&lt;/font&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━&lt;br&gt;&lt;b&gt;In:&lt;/b&gt;&amp;nbsp; source WAV&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; x-vector (192,)&lt;br&gt;&lt;br&gt;Res2Net + SE + pooling&lt;br&gt;⚠ also encodes emotion&lt;br&gt;→ EASE removes emotion" vertex="1">
          <mxGeometry height="150" width="246" x="248" y="470" as="geometry" />
        </mxCell>
        <mxCell id="w2v" parent="1" style="rounded=1;arcSize=8;fillColor=#fff8e1;strokeColor=#f9a825;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;whiteSpace=wrap;html=1;" value="&lt;b&gt;wav2vec2 (summed)&lt;/b&gt; 🔒&lt;br&gt;&lt;font color=&#39;#888&#39;&gt;wav2vec2-large-robust-ft-swbd&lt;/font&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━&lt;br&gt;&lt;b&gt;In:&lt;/b&gt;&amp;nbsp; reference WAV&lt;br&gt;&lt;b&gt;Op:&lt;/b&gt;&amp;nbsp; sum 13 hidden layers&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; (T, 768) frame feats&lt;br&gt;&lt;br&gt;Encodes emotion + speaker&lt;br&gt;→ SACE extracts emotion" vertex="1">
          <mxGeometry height="155" width="246" x="248" y="640" as="geometry" />
        </mxCell>
        <mxCell id="ease" parent="1" style="rounded=1;arcSize=8;fillColor=#e8f5e9;strokeColor=#388e3c;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;whiteSpace=wrap;html=1;" value="&lt;b&gt;EASE&lt;/b&gt; 🔵 ↺&lt;br&gt;&lt;font color=&#39;#555&#39;&gt;Emotion-Agnostic Speaker Encoder&lt;/font&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━&lt;br&gt;&lt;b&gt;In:&lt;/b&gt;&amp;nbsp; x-vec (192,)&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; speaker emb (256,)&lt;br&gt;&lt;br&gt;FC 192 → 512 → 256&lt;br&gt;Adv: GradRev → FC → 10 classes&lt;br&gt;&lt;i&gt;Removes emotion from speaker&lt;/i&gt;" vertex="1">
          <mxGeometry height="170" width="246" x="532" y="390" as="geometry" />
        </mxCell>
        <mxCell id="sace" parent="1" style="rounded=1;arcSize=8;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;whiteSpace=wrap;html=1;" value="&lt;b&gt;SACE&lt;/b&gt; 🔵 ↺&lt;br&gt;&lt;font color=&#39;#555&#39;&gt;Speaker-Adversarial Classifier of Emo&lt;/font&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━&lt;br&gt;&lt;b&gt;In:&lt;/b&gt;&amp;nbsp; (T, 768) w2v feats&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; emotion emb (128,)&lt;br&gt;&lt;br&gt;Conv1d(768→128,k=5) × 2&lt;br&gt;Mean-pool → 5-class + adv 10-class&lt;br&gt;&lt;i&gt;Removes speaker from emotion&lt;/i&gt;" vertex="1">
          <mxGeometry height="175" width="246" x="532" y="590" as="geometry" />
        </mxCell>
        <mxCell id="f0a" parent="1" style="rounded=1;arcSize=8;fillColor=#e0f7fa;strokeColor=#00796b;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;whiteSpace=wrap;html=1;" value="&lt;b&gt;① Token Embedding&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;nn.Embedding(101, 128, pad=100)&lt;br&gt;&lt;b&gt;In:&lt;/b&gt;&amp;nbsp; (B, T) int tokens&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; (B, T, 128)" vertex="1">
          <mxGeometry height="90" width="336" x="812" y="120" as="geometry" />
        </mxCell>
        <mxCell id="f0b" parent="1" style="rounded=1;arcSize=8;fillColor=#e0f7fa;strokeColor=#00796b;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;whiteSpace=wrap;html=1;" value="&lt;b&gt;② Speaker Context Injection&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;EASE (256,) → Linear(256→128)&lt;br&gt;Broadcast: (B,1,128) → (B,T,128)&lt;br&gt;emo_embed += speaker_proj&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; fused context (B, T, 128)" vertex="1">
          <mxGeometry height="105" width="336" x="812" y="230" as="geometry" />
        </mxCell>
        <mxCell id="f0c" parent="1" style="rounded=1;arcSize=8;fillColor=#b2ebf2;strokeColor=#00796b;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;whiteSpace=wrap;html=1;" value="&lt;b&gt;③ CrossAttentionModel (4-head MHA)&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;&lt;b&gt;Q&lt;/b&gt; = unit emb &amp;nbsp;&amp;nbsp;→ fc_q → (B,T,256)&lt;br&gt;&lt;b&gt;K&lt;/b&gt; = emo+spk → fc_k → (B,T,256)&lt;br&gt;&lt;b&gt;V&lt;/b&gt; = emo+spk → fc_v → (B,T,256)&lt;br&gt;Attention: Q·Kᵀ/√64 → softmax → ·V&lt;br&gt;→ fc(256→128) + residual + LayerNorm&lt;br&gt;→ fc_1(128→128) + residual + LayerNorm&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; (B, T, 128) · dropout=0.5" vertex="1">
          <mxGeometry height="185" width="336" x="812" y="355" as="geometry" />
        </mxCell>
        <mxCell id="f0d" parent="1" style="rounded=1;arcSize=8;fillColor=#e0f7fa;strokeColor=#00796b;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;whiteSpace=wrap;html=1;" value="&lt;b&gt;④ CNN Regression Head&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;Permute (B,T,128)→(B,128,T)&lt;br&gt;Conv1d(128→128, k=3) + LeakyReLU&lt;br&gt;Conv1d(128→1, k=1) → squeeze&lt;br&gt;Mask padding → pred (B, T)" vertex="1">
          <mxGeometry height="100" width="336" x="812" y="560" as="geometry" />
        </mxCell>
        <mxCell id="f0e" parent="1" style="rounded=1;arcSize=8;fillColor=#a5f3f7;strokeColor=#00796b;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;whiteSpace=wrap;html=1;" value="&lt;b&gt;⑤ F0 Output&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;pred_f0 = exp(logit) − 1&lt;br&gt;&lt;b&gt;Shape:&lt;/b&gt; (B, T) float · Hz&lt;br&gt;&lt;b&gt;Range:&lt;/b&gt; 60–300 Hz voiced" vertex="1">
          <mxGeometry height="80" width="336" x="812" y="680" as="geometry" />
        </mxCell>
        <mxCell id="f0loss" parent="1" style="rounded=1;arcSize=8;fillColor=#fff8e1;strokeColor=#e65100;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;whiteSpace=wrap;html=1;dashed=1;dashPattern=7 4;" value="&lt;b&gt;⑥ Losses (train only)&lt;/b&gt; 🔴&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;&lt;b&gt;L1:&lt;/b&gt;&amp;nbsp;&amp;nbsp; Σ mask·|pred_f0 − YAAPT|&lt;br&gt;&lt;b&gt;CE₁:&lt;/b&gt; CE(emo_logits, emo_label)&lt;br&gt;&lt;b&gt;CE₂:&lt;/b&gt; CE(spk_logits,  spk_label)&lt;br&gt;&lt;b&gt;Total = L1 + 1000·CE₁ + 1000·CE₂&lt;/b&gt;&lt;br&gt;Adam lr=1e-3 · decay ×0.5/7ep" vertex="1">
          <mxGeometry height="118" width="336" x="812" y="782" as="geometry" />
        </mxCell>
        <mxCell id="va" parent="1" style="rounded=1;arcSize=8;fillColor=#fce4ec;strokeColor=#c62828;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;whiteSpace=wrap;html=1;" value="&lt;b&gt;① Unit Embedding&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;nn.Embedding(100, 128)&lt;br&gt;&lt;b&gt;In:&lt;/b&gt;&amp;nbsp; (B, T) int&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; (B, 128, T)" vertex="1">
          <mxGeometry height="85" width="336" x="1182" y="120" as="geometry" />
        </mxCell>
        <mxCell id="vb" parent="1" style="rounded=1;arcSize=8;fillColor=#fce4ec;strokeColor=#c62828;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;whiteSpace=wrap;html=1;" value="&lt;b&gt;② Conditioning Stack&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;F0Encoder(128): (B,1,T) → (B,128,T)&lt;br&gt;EASE: (B,256) → upsample → (B,256,T)&lt;br&gt;SACE: (B,128) → upsample → (B,128,T)&lt;br&gt;cat(dim=1) → (B, 640, T)&lt;br&gt;conv_pre Conv1d(640→512) → (B,512,T)" vertex="1">
          <mxGeometry height="130" width="336" x="1182" y="225" as="geometry" />
        </mxCell>
        <mxCell id="vc" parent="1" style="rounded=1;arcSize=8;fillColor=#f8bbd0;strokeColor=#c62828;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;whiteSpace=wrap;html=1;" value="&lt;b&gt;③ CodeGenerator (HiFi-GAN)&lt;/b&gt;&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;5 upsample stages · &lt;b&gt;×160 total&lt;/b&gt;&lt;br&gt;&amp;nbsp; ×5→×4→×4→×2→×2&lt;br&gt;&amp;nbsp; 512→256→128→64→32→16 ch&lt;br&gt;MRF blocks: kernels [3,7,11]&lt;br&gt;&amp;nbsp; dilations [[1,3,5]×3 pairs]&lt;br&gt;conv_post Conv1d(16→1) + tanh&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; (B,1,T×160) ∈ [−1,+1]" vertex="1">
          <mxGeometry height="180" width="336" x="1182" y="375" as="geometry" />
        </mxCell>
        <mxCell id="vd" parent="1" style="rounded=1;arcSize=8;fillColor=#fff8e1;strokeColor=#e65100;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;whiteSpace=wrap;html=1;dashed=1;dashPattern=7 4;" value="&lt;b&gt;④ Discriminators&lt;/b&gt; 🔴&lt;br&gt;━━━━━━━━━━━━━━━━━━━━━━━━━━&lt;br&gt;&lt;b&gt;MPD:&lt;/b&gt; periods [2,3,5,7,11]&lt;br&gt;&amp;nbsp;&amp;nbsp; reshape (B,1,T)→(B,1,T//p,p)&lt;br&gt;&amp;nbsp;&amp;nbsp; 5-layer Conv2d + wNorm&lt;br&gt;&lt;b&gt;MSD:&lt;/b&gt; scales ×1 · ×4 · ×16&lt;br&gt;&amp;nbsp;&amp;nbsp; 7-layer Conv1d + spectral/wNorm" vertex="1">
          <mxGeometry height="155" width="336" x="1182" y="575" as="geometry" />
        </mxCell>
